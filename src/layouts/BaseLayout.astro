---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'terms' | 'privacy';
}

const { title, description, active = 'home' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={siteConfig.draft ? 'noindex, nofollow, noarchive' : 'index, follow'} />
    <meta name="theme-color" content="#2f292d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}the-mayling-bot.png`} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('mayling-theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        } catch {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header active={active} />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
